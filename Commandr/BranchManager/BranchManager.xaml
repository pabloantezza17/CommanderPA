<Controls:MetroWindow x:Class="Commandr.BranchManager"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:local="clr-namespace:Commandr"
        x:Name="Window" WindowStartupLocation="CenterScreen"
        WindowStyle="ToolWindow" ResizeMode="NoResize"
        Title="Branches" Width="240" Height="320"
        TitleCharacterCasing="Normal"
        BorderThickness="1"
        BorderBrush="{DynamicResource AccentColorBrush}">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Add row -->
        <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" x:Name="AddButton" Click="AddButton_Click"
                    Width="28" Margin="6,0,0,0" ToolTip="Agregar branch">
                <iconPacks:PackIconMaterial Kind="Plus" Width="12" Height="12" />
            </Button>
            <TextBox x:Name="NewBranchBox" KeyDown="NewBranchBox_KeyDown"
                     Controls:TextBoxHelper.Watermark="Nueva branch..."
                     Controls:TextBoxHelper.ClearTextButton="True" />
        </DockPanel>

        <!-- Branch list -->
        <ListBox x:Name="BranchesList" Grid.Row="1"
                 ItemsSource="{Binding}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid MinHeight="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="1" Click="RemoveButton_Click"
                                Tag="{Binding}" BorderThickness="0"
                                Background="Transparent" Padding="4,0"
                                ToolTip="Quitar">
                            <iconPacks:PackIconMaterial Kind="Close" Width="10" Height="10" Opacity="0.6" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="CancelButton" Content="Cancelar" Click="CancelButton_Click"
                    Width="78" Margin="0,0,6,0" />
            <Button x:Name="SaveButton" Content="Guardar" Click="SaveButton_Click"
                    Width="78" Style="{DynamicResource AccentedSquareButtonStyle}" />
        </StackPanel>
    </Grid>
</Controls:MetroWindow>
