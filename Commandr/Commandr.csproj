<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Commandr</RootNamespace>
    <AssemblyName>Commandr</AssemblyName>
    <!-- NotifyIcon (TrayIcon) e InputBox usan Windows Forms. -->
    <UseWindowsForms>true</UseWindowsForms>
    <StartupObject>Commandr.App</StartupObject>
    <ApplicationIcon>commander.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ByteSize" Version="2.1.2" />
    <PackageReference Include="MahApps.Metro" Version="2.4.10" />
    <PackageReference Include="MahApps.Metro.IconPacks.Material" Version="5.1.0" />
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Framework\Framework.csproj" />
    <ProjectReference Include="..\Helper\Helper.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Images\status.png" />
    <Resource Include="commander.ico" />
    <Content Include="7za.exe" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="ConnectionStrings.xml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Images\BatFile.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Images\commander.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Images\executable.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Images\Solution.png" CopyToOutputDirectory="PreserveNewest" />
    <None Update="install.bat" CopyToOutputDirectory="PreserveNewest" />
    <None Update="reset_iis.bat" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
