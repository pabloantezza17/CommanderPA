<Controls:MetroWindow x:Class="Commandr.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:local="clr-namespace:Commandr"
        x:Name="Window" WindowStartupLocation="CenterScreen"
        WindowStyle="ToolWindow" ResizeMode="CanResizeWithGrip"
        ShowMaxRestoreButton="False"
        Title="Commandr"
        Width="300" Height="460"
        MinWidth="240" MinHeight="280" MaxHeight="700"
        TitleCharacterCasing="Normal"
        BorderThickness="1"
        BorderBrush="{DynamicResource AccentColorBrush}">

    <Controls:MetroWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Controls:MetroWindow.Resources>

    <Grid Margin="10,8,10,4">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Branch selector -->
        <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Left" Text="Branch"
                       VerticalAlignment="Center" Margin="0,0,8,0"
                       Opacity="0.7" FontWeight="SemiBold" />
            <Button DockPanel.Dock="Right" x:Name="ManageBranchesButton"
                    Click="ManageBranchesButton_Click"
                    Width="28" Margin="6,0,0,0" ToolTip="Administrar branches">
                <iconPacks:PackIconMaterial Kind="Pencil" Width="11" Height="11" />
            </Button>
            <ComboBox
                IsEditable="True"
                ItemsSource="{Binding Path=Branches}"
                Text="{Binding Path=CurrentBranch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Controls:TextBoxHelper.Watermark="Branch o 'Todas'"
                VerticalAlignment="Center" />
        </DockPanel>

        <!-- Search box -->
        <TextBox x:Name="SearchBox" Grid.Row="1"
                 Margin="0,0,0,6"
                 KeyDown="SearchBox_KeyDown"
                 Text="{Binding Path=SearchText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                 Controls:TextBoxHelper.Watermark="Buscar comando..."
                 Controls:TextBoxHelper.ClearTextButton="True"
                 Controls:TextBoxHelper.SelectAllOnFocus="True" />

        <Separator Grid.Row="2" Margin="0,0,0,4" Opacity="0.4" />

        <!-- Commands -->
        <ListBox
            x:Name="CommandsList"
            PreviewMouseRightButtonDown="CommandsList_MouseRightButtonDown"
            MouseDoubleClick="CommandsList_MouseDoubleClick"
            KeyDown="CommandsList_KeyDown"
            Grid.Row="3"
            ItemsSource="{Binding Path=ActionsView}"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            ScrollViewer.CanContentScroll="False"
            VirtualizingPanel.ScrollUnit="Pixel"
            HorizontalContentAlignment="Stretch">

            <ListBox.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="2,6,0,2">
                                <iconPacks:PackIconMaterial Width="11" Height="11"
                                        VerticalAlignment="Center" Margin="0,0,5,0"
                                        Foreground="{DynamicResource AccentColorBrush}">
                                    <iconPacks:PackIconMaterial.Style>
                                        <Style TargetType="iconPacks:PackIconMaterial">
                                            <Setter Property="Kind" Value="Folder" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Path=Name}" Value="Scripts">
                                                    <Setter Property="Kind" Value="ScriptText" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Path=Name}" Value="Soluciones">
                                                    <Setter Property="Kind" Value="VisualStudio" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Path=Name}" Value="Herramientas">
                                                    <Setter Property="Kind" Value="Toolbox" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </iconPacks:PackIconMaterial.Style>
                                </iconPacks:PackIconMaterial>
                                <TextBlock Text="{Binding Path=Name}"
                                           FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentColorBrush}"
                                           Opacity="0.85" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListBox.GroupStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid MinHeight="24" Margin="0,2" ToolTip="{Binding Path=SecondaryActionHint}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Vector icon: inherits foreground, so it inverts on selection -->
                        <iconPacks:PackIconMaterial Grid.Column="0"
                               Kind="{Binding Path=IconKind}"
                               Width="15" Height="15" Margin="2,0,9,0"
                               VerticalAlignment="Center" />

                        <TextBlock Grid.Column="1" Text="{Binding Path=Name}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />

                        <!-- Secondary-action indicator -->
                        <iconPacks:PackIconMaterial Grid.Column="2"
                               Kind="SubdirectoryArrowLeft"
                               Width="12" Height="12" Margin="6,0,2,0"
                               VerticalAlignment="Center" Opacity="0.55"
                               ToolTip="{Binding Path=SecondaryActionHint}"
                               Visibility="{Binding Path=HasSecondaryAction,
                                            Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Empty-search state -->
        <TextBlock Grid.Row="3" Text="Sin resultados"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsHitTestVisible="False" Opacity="0.5" FontStyle="Italic">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Path=Items.Count, ElementName=CommandsList}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

    </Grid>

</Controls:MetroWindow>
