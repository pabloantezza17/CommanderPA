<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Commandr.ScriptRunner.ScriptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Commandr.ScriptRunner"
        Title="{Binding Path=Title}"
        Height="620"
        Width="860"
        MinHeight="420"
        MinWidth="560"
        WindowStartupLocation="CenterScreen"
        Icon="../commander.ico"
        FontFamily="Segoe UI"
        Background="#FFEEF1F5">

    <Window.Resources>

        <SolidColorBrush x:Key="TextBrush" Color="#FF1F2430" />
        <SolidColorBrush x:Key="MutedBrush" Color="#FF98A0AD" />
        <SolidColorBrush x:Key="BorderBrush" Color="#FFE4E8EE" />
        <SolidColorBrush x:Key="GreenBrush" Color="#FF22A65B" />
        <SolidColorBrush x:Key="RedBrush" Color="#FFE5484D" />
        <SolidColorBrush x:Key="TealBrush" Color="#FF12A4A4" />

        <!-- Botón redondeado plano para "Cerrar" -->
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource TealBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="12">

        <DockPanel>

            <!-- Header -->
            <Border DockPanel.Dock="Top"
                    Background="#FF232833"
                    CornerRadius="10"
                    Padding="18,14"
                    Margin="0,0,0,10">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="AccentBar"
                                Width="6"
                                Height="22"
                                CornerRadius="3"
                                Background="{StaticResource TealBrush}"
                                Margin="0,0,12,0" />
                        <TextBlock Text="{Binding Path=Title}"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding Path=Subtitle}"
                               Foreground="#FFB9C0CC"
                               FontSize="13"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Barra de estado + progreso -->
            <Border DockPanel.Dock="Top"
                    Background="White"
                    CornerRadius="10"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    Padding="16,12"
                    Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="{Binding Path=StatusText}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" />
                    <ProgressBar IsIndeterminate="True"
                                 Height="5"
                                 Margin="0,10,0,0"
                                 Foreground="{StaticResource TealBrush}"
                                 Background="#FFEDEFF3"
                                 BorderThickness="0"
                                 Visibility="{Binding Path=ShowWorking}" />
                </StackPanel>
            </Border>

            <!-- Pie: botón cerrar (visible al terminar) -->
            <Border DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <Button Content="Cerrar"
                        HorizontalAlignment="Right"
                        Style="{StaticResource FlatButton}"
                        IsCancel="True"
                        Click="Close_Click" />
            </Border>

            <!-- Salida en vivo -->
            <Border Background="#FF1E2229"
                    CornerRadius="10"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1">
                <ListBox Name="OutputList"
                         ItemsSource="{Binding Path=Output, Mode=OneWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="#FFD6DBE3"
                         FontFamily="Consolas"
                         FontSize="12.5"
                         Padding="10,8"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="2,1" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="{TemplateBinding Background}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="NoWrap" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </DockPanel>
    </Grid>
</Window>
