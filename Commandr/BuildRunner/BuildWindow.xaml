<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Commandr.BuildRunner.BuildWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Commandr.BuildRunner"
        Title="Compilando"
        Height="560"
        Width="760"
        MinHeight="420"
        MinWidth="560"
        WindowStartupLocation="CenterScreen"
        Icon="../commander.ico"
        FontFamily="Segoe UI"
        Background="#FFEEF1F5">

    <Window.Resources>

        <SolidColorBrush x:Key="TextBrush" Color="#FF1F2430" />
        <SolidColorBrush x:Key="MutedBrush" Color="#FF98A0AD" />
        <SolidColorBrush x:Key="BorderBrush" Color="#FFE4E8EE" />
        <SolidColorBrush x:Key="GreenBrush" Color="#FF22A65B" />
        <SolidColorBrush x:Key="RedBrush" Color="#FFE5484D" />
        <SolidColorBrush x:Key="PurpleBrush" Color="#FF6B5BFF" />

        <!-- Fila de error: punto rojo + archivo + mensaje -->
        <DataTemplate x:Key="ErrorItemTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse Grid.Column="0"
                         Width="9"
                         Height="9"
                         Margin="0,5,10,0"
                         VerticalAlignment="Top"
                         Fill="{StaticResource RedBrush}" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding File}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Message}"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0"
                               Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <Style TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b"
                                Background="White"
                                CornerRadius="8"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#FFFDF3F3" />
                                <Setter TargetName="b" Property="BorderBrush" Value="#FFF3C9C9" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#FFFDF3F3" />
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource RedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,8" />
            <Setter Property="ItemTemplate" Value="{StaticResource ErrorItemTemplate}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        </Style>

    </Window.Resources>

    <Grid Margin="12">

        <DockPanel>

            <!-- Header -->
            <Border DockPanel.Dock="Top"
                    Background="#FF232833"
                    CornerRadius="10"
                    Padding="18,14"
                    Margin="0,0,0,10">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="AccentBar"
                                Width="6"
                                Height="22"
                                CornerRadius="3"
                                Background="{StaticResource PurpleBrush}"
                                Margin="0,0,12,0" />
                        <TextBlock Text="Build"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding Path=Title}"
                               Foreground="#FFB9C0CC"
                               FontSize="13"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>

            <!-- Cuerpo: card blanca que aloja los tres estados -->
            <Border Background="White"
                    CornerRadius="10"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1">
                <Grid>

                    <!-- Estado: compilando -->
                    <StackPanel Visibility="{Binding Path=ShowBuilding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding Path=StatusText}"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,18" />
                        <ProgressBar IsIndeterminate="True"
                                     Width="320"
                                     Height="6"
                                     Foreground="{StaticResource PurpleBrush}"
                                     Background="#FFEDEFF3"
                                     BorderThickness="0" />
                        <TextBlock Text="{Binding Path=SolutionName}"
                                   FontSize="13"
                                   Foreground="{StaticResource MutedBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,16,0,0" />
                    </StackPanel>

                    <!-- Estado: éxito -->
                    <StackPanel Visibility="{Binding Path=ShowSuccess}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="&#x2713;"
                                   FontSize="128"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource GreenBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="COMPILACIÓN EXITOSA"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,-8,0,0" />
                    </StackPanel>

                    <!-- Estado: errores -->
                    <DockPanel Visibility="{Binding Path=ShowFailed}" Margin="4">
                        <Border DockPanel.Dock="Top"
                                Margin="8,10,8,4">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="10" Height="10" CornerRadius="5"
                                        Background="{StaticResource RedBrush}"
                                        VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Text="{Binding Path=CantErrors}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource RedBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ListBox Name="ListErrors"
                                 ItemsSource="{Binding Path=Errors, Mode=OneWay}"
                                 MouseDoubleClick="ListErrors_MouseDoubleClick" />
                    </DockPanel>

                </Grid>
            </Border>
        </DockPanel>
    </Grid>
</Window>
