<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Commandr.UpdateRunner.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Commandr.UpdateRunner"
        Title="Update + Build + Test"
        Height="720"
        Width="860"
        MinHeight="600"
        MinWidth="640"
        WindowStartupLocation="CenterScreen"
        Icon="../commander.ico"
        FontFamily="Segoe UI"
        Background="#FFEEF1F5">

    <Window.Resources>

        <SolidColorBrush x:Key="TextBrush" Color="#FF1F2430" />
        <SolidColorBrush x:Key="MutedBrush" Color="#FF98A0AD" />
        <SolidColorBrush x:Key="BorderBrush" Color="#FFE4E8EE" />
        <SolidColorBrush x:Key="GreenBrush" Color="#FF22A65B" />
        <SolidColorBrush x:Key="RedBrush" Color="#FFE5484D" />
        <SolidColorBrush x:Key="TealBrush" Color="#FF12A4A4" />
        <SolidColorBrush x:Key="AmberBrush" Color="#FFE59A1F" />

        <!-- Botón de frenado: chato, rojo, sobre el header oscuro -->
        <Style x:Key="CancelButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b"
                                Background="{StaticResource RedBrush}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#FFC93B40" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#FFA82F33" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fila de paso: glyph de estado + nombre -->
        <DataTemplate x:Key="StepItemTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="glyph"
                           Grid.Column="0"
                           Text="&#x2022;"
                           FontSize="14"
                           Width="20"
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}" />
                <TextBlock x:Name="label"
                           Grid.Column="1"
                           Text="{Binding Name}"
                           Margin="6,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextBrush}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Running">
                    <Setter TargetName="glyph" Property="Text" Value="&#x25B6;" />
                    <Setter TargetName="glyph" Property="Foreground" Value="{StaticResource TealBrush}" />
                    <Setter TargetName="label" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Ok">
                    <Setter TargetName="glyph" Property="Text" Value="&#x2713;" />
                    <Setter TargetName="glyph" Property="Foreground" Value="{StaticResource GreenBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Failed">
                    <Setter TargetName="glyph" Property="Text" Value="&#x2717;" />
                    <Setter TargetName="glyph" Property="Foreground" Value="{StaticResource RedBrush}" />
                    <Setter TargetName="label" Property="Foreground" Value="{StaticResource RedBrush}" />
                    <Setter TargetName="label" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <!-- Frenado en el medio: cuadrado de "stop" ámbar. -->
                <DataTrigger Binding="{Binding State}" Value="Cancelled">
                    <Setter TargetName="glyph" Property="Text" Value="&#x25A0;" />
                    <Setter TargetName="glyph" Property="FontSize" Value="11" />
                    <Setter TargetName="glyph" Property="Foreground" Value="{StaticResource AmberBrush}" />
                    <Setter TargetName="label" Property="Foreground" Value="{StaticResource AmberBrush}" />
                    <Setter TargetName="label" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <!-- Nunca arrancó: círculo vacío gris. -->
                <DataTrigger Binding="{Binding State}" Value="Skipped">
                    <Setter TargetName="glyph" Property="Text" Value="&#x25CB;" />
                    <Setter TargetName="glyph" Property="FontSize" Value="11" />
                    <Setter TargetName="glyph" Property="Foreground" Value="{StaticResource MutedBrush}" />
                    <Setter TargetName="label" Property="Foreground" Value="{StaticResource MutedBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="StepListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="12">

        <DockPanel>

            <!-- Header -->
            <Border DockPanel.Dock="Top"
                    Background="#FF232833"
                    CornerRadius="10"
                    Padding="18,14"
                    Margin="0,0,0,10">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="AccentBar"
                                Width="6"
                                Height="22"
                                CornerRadius="3"
                                Background="{StaticResource TealBrush}"
                                Margin="0,0,12,0" />
                        <TextBlock Text="Update + Build + Test"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding Path=Title}"
                                   Foreground="#FFB9C0CC"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="0,0,14,0"
                                   TextTrimming="CharacterEllipsis" />
                        <Button Content="Frenar"
                                Style="{StaticResource CancelButtonStyle}"
                                Visibility="{Binding Path=ShowCancel}"
                                Click="Cancel_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Barra de estado + progreso -->
            <Border DockPanel.Dock="Top"
                    Background="White"
                    CornerRadius="10"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    Padding="16,12"
                    Margin="0,0,0,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <!-- Cuadrado de "stop" ámbar: sólo cuando se frenó el proceso. -->
                        <Rectangle Width="10"
                                   Height="10"
                                   RadiusX="2"
                                   RadiusY="2"
                                   Fill="{StaticResource AmberBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,9,0"
                                   Visibility="{Binding Path=ShowCancelled}" />
                        <TextBlock Text="{Binding Path=StatusText}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextBrush}" />
                    </StackPanel>
                    <ProgressBar IsIndeterminate="True"
                                 Height="5"
                                 Margin="0,10,0,0"
                                 Foreground="{StaticResource TealBrush}"
                                 Background="#FFEDEFF3"
                                 BorderThickness="0"
                                 Visibility="{Binding Path=ShowWorking}" />
                    <!-- Barra congelada: mantiene la altura de la tarjeta al frenar. -->
                    <Border Height="5"
                            CornerRadius="2.5"
                            Margin="0,10,0,0"
                            Background="#FFF6E2C0"
                            Visibility="{Binding Path=ShowCancelled}" />
                </StackPanel>
            </Border>

            <!-- Cuerpo: pasos (izq) + salida en vivo (der) -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="White"
                        CornerRadius="10"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        Margin="0,0,10,0">
                    <ListBox ItemsSource="{Binding Path=Steps, Mode=OneWay}"
                             ItemTemplate="{StaticResource StepItemTemplate}"
                             ItemContainerStyle="{StaticResource StepListItemStyle}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="6"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                </Border>

                <Border Grid.Column="1"
                        Background="#FF1E2229"
                        CornerRadius="10"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1">
                    <ListBox Name="OutputList"
                             ItemsSource="{Binding Path=Output, Mode=OneWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="#FFD6DBE3"
                             FontFamily="Consolas"
                             FontSize="12.5"
                             Padding="10,8"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Padding" Value="2,1" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="{TemplateBinding Background}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="NoWrap" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
