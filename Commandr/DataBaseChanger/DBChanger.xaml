<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Commandr.DataBaseChanger.DBChanger"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Commandr.DataBaseChanger"
        x:Name="Window"
        Title="Change DB"
        Height="520"
        Width="420"
        MinHeight="360"
        MinWidth="340"
        WindowStartupLocation="CenterScreen"
        Icon="../commander.ico"
        FontFamily="Segoe UI"
        Background="#FFEEF1F5">

    <Window.Resources>

        <SolidColorBrush x:Key="TextBrush" Color="#FF1F2430" />
        <SolidColorBrush x:Key="MutedBrush" Color="#FF98A0AD" />
        <SolidColorBrush x:Key="BorderBrush" Color="#FFE4E8EE" />
        <SolidColorBrush x:Key="TealBrush" Color="#FF12A4A4" />

        <!-- Ítem de la lista de bases de datos -->
        <Style x:Key="DbItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd"
                                Background="Transparent"
                                CornerRadius="6"
                                Margin="0,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFEDF6F6" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource TealBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón plano redondeado -->
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TealBrush}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource TealBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFEDF6F6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="12">

        <DockPanel>

            <!-- Header -->
            <Border DockPanel.Dock="Top"
                    Background="#FF232833"
                    CornerRadius="10"
                    Padding="18,14"
                    Margin="0,0,0,10">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="6" Height="22" CornerRadius="3"
                                Background="{StaticResource TealBrush}" Margin="0,0,12,0" />
                        <TextBlock Text="Change DB"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="BranchLabel"
                               Foreground="#FFB9C0CC"
                               FontSize="13"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>

            <!-- Pie: hint + botón Custom -->
            <Border DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <Grid>
                    <TextBlock VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap"
                               Text="Doble clic aplica en 4P020\SQL19 · Enter en SERVER21\SQL2014ENT" />
                    <Button x:Name="CustomDB"
                            Content="Custom..."
                            HorizontalAlignment="Right"
                            Style="{StaticResource FlatButton}"
                            Click="CustomDB_Click" />
                </Grid>
            </Border>

            <!-- Buscador -->
            <Border DockPanel.Dock="Top"
                    Background="White"
                    CornerRadius="10"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    Padding="4"
                    Margin="0,0,0,10">
                <TextBox x:Name="SearchBox"
                         BorderThickness="0"
                         Background="Transparent"
                         FontSize="13"
                         Padding="8,6"
                         VerticalContentAlignment="Center"
                         TextChanged="SearchBox_TextChanged" />
            </Border>

            <!-- Lista de bases de datos -->
            <Border Background="White"
                    CornerRadius="10"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1">
                <ListBox x:Name="DataBaseList"
                         MouseDoubleClick="DataBaseList_MouseDoubleClick"
                         KeyDown="DataBaseList_KeyDown"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="6"
                         ItemContainerStyle="{StaticResource DbItemStyle}"
                         IsTextSearchEnabled="True"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </Border>
        </DockPanel>
    </Grid>
</Window>
