<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>TestRunner</RootNamespace>
    <AssemblyName>TestRunner</AssemblyName>
    <StartupObject>TestRunner.App</StartupObject>
    <ApplicationIcon>runner.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WpfAnimatedGif" Version="2.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="runner.ico" />
    <Resource Include="runner.png" />
    <Content Include="gifs\*.gif" CopyToOutputDirectory="Always" />
    <Content Include="Fast.testsettings" CopyToOutputDirectory="Always" />
    <None Update="build_and_test_vs2017.bat" CopyToOutputDirectory="Always" />
    <None Update="update_build_and_test_vs2017.bat" CopyToOutputDirectory="Always" />
  </ItemGroup>

  <!-- Ruta relativa al proyecto, no a la solucion: $(SolutionDir) cambia segun si se compila
       con FullSolution.sln o con TestRunner.sln, y con la segunda el xcopy armaba un deploy
       huerfano en TestRunner\Commandr\ que no es el que lanza Commandr. -->
  <Target Name="CopyToCommandr" AfterTargets="Build">
    <Exec Command="xcopy /E /Y /I /Q &quot;$(ProjectDir)$(OutDir)*&quot; &quot;$(ProjectDir)..\Commandr\$(OutDir)TestRunner\&quot;" />
  </Target>

</Project>
