<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="TestRunner.TestRunnerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TestRunner"
        Title="Test Runner"
        Height="480"
        Width="680"
        MinHeight="380"
        MinWidth="520"
        WindowStartupLocation="CenterScreen"
        Icon="runner.ico"
        FontFamily="Segoe UI"
        Background="#FFEEF1F5"
        Closing="Window_Closing">

    <Window.Resources>

        <SolidColorBrush x:Key="TextBrush" Color="#FF1F2430" />
        <SolidColorBrush x:Key="MutedBrush" Color="#FF98A0AD" />
        <SolidColorBrush x:Key="BorderBrush" Color="#FFE4E8EE" />
        <SolidColorBrush x:Key="GreenBrush" Color="#FF22A65B" />
        <SolidColorBrush x:Key="RedBrush" Color="#FFE5484D" />
        <SolidColorBrush x:Key="TealBrush" Color="#FF12A4A4" />
        <SolidColorBrush x:Key="PurpleBrush" Color="#FF6B5BFF" />

        <!-- Fila de test: punto de estado por color + descripción -->
        <DataTemplate x:Key="TestItemTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="dot"
                         Grid.Column="0"
                         Width="9"
                         Height="9"
                         Margin="0,4,10,0"
                         VerticalAlignment="Top"
                         Fill="{StaticResource MutedBrush}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Description}"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextBrush}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Failed">
                    <Setter TargetName="dot" Property="Fill" Value="{StaticResource RedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Passed">
                    <Setter TargetName="dot" Property="Fill" Value="{StaticResource GreenBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Integration">
                    <Setter TargetName="dot" Property="Fill" Value="{StaticResource TealBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Inconclusive">
                    <Setter TargetName="dot" Property="Fill" Value="#FFF5A623" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Menú contextual para copiar clase/test y rastrearlo en la solución -->
        <ContextMenu x:Key="TestContextMenu">
            <MenuItem Header="Copiar clase y test" Click="CopyClassAndTest_Click" />
            <MenuItem Header="Copiar clase" Click="CopyClass_Click" />
            <MenuItem Header="Copiar test" Click="CopyTest_Click" />
            <Separator />
            <MenuItem Header="Copiar nombre completo" Click="CopyFullName_Click" />
        </ContextMenu>

        <Style TargetType="ListBoxItem">
            <Setter Property="ContextMenu" Value="{StaticResource TestContextMenu}" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b"
                                Background="White"
                                CornerRadius="8"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#FFF3F6FF" />
                                <Setter TargetName="b" Property="BorderBrush" Value="#FFCBD5FF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#FFF3F6FF" />
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource PurpleBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,8" />
            <Setter Property="ItemTemplate" Value="{StaticResource TestItemTemplate}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="wrap"
                                Background="Transparent"
                                CornerRadius="8,8,0,0"
                                Padding="18,11">
                            <Grid>
                                <ContentPresenter x:Name="cp"
                                                  ContentSource="Header"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  TextElement.Foreground="{StaticResource MutedBrush}" />
                                <Border x:Name="underline"
                                        Height="3"
                                        CornerRadius="2"
                                        VerticalAlignment="Bottom"
                                        Margin="2,0,2,-1"
                                        Background="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                                        Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="underline" Property="Visibility" Value="Visible" />
                                <Setter TargetName="wrap" Property="Background" Value="White" />
                                <Setter TargetName="cp" Property="TextElement.Foreground"
                                        Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="wrap" Property="Background" Value="#FFF7F9FC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel>
                            <Border DockPanel.Dock="Top"
                                    Background="White"
                                    CornerRadius="10,10,0,0"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1,1,1,0">
                                <TabPanel IsItemsHost="True" Margin="6,4,6,0" Background="Transparent" />
                            </Border>
                            <Border Background="White"
                                    CornerRadius="0,0,10,10"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1,0,1,1">
                                <ContentPresenter ContentSource="SelectedContent" Margin="4" />
                            </Border>
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="12">

        <!-- Indicador mientras corren los tests -->
        <StackPanel Visibility="{Binding Path=ShowLoading}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <TextBlock Text="Corriendo tests..."
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,18" />
            <ProgressBar IsIndeterminate="True"
                         Width="320"
                         Height="6"
                         Foreground="{StaticResource GreenBrush}"
                         Background="#FFEDEFF3"
                         BorderThickness="0" />
        </StackPanel>

        <DockPanel Visibility="{Binding Path=ShowTabs}">

            <!-- Header -->
            <Border DockPanel.Dock="Top"
                    Background="#FF232833"
                    CornerRadius="10"
                    Padding="18,14"
                    Margin="0,0,0,10">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="6" Height="22" CornerRadius="3" Background="{StaticResource GreenBrush}" Margin="0,0,12,0" />
                        <TextBlock Text="Test Runner"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding Path=Title}"
                               Foreground="#FFB9C0CC"
                               FontSize="13"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>

            <TabControl>
                <TabItem Header="{Binding Path=CantPassed}" Foreground="{StaticResource GreenBrush}">
                    <Grid>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Path=PassedTestsCounter}"
                                       FontSize="128"
                                       FontWeight="Bold"
                                       Foreground="{Binding Path=PassedTestCounterColor}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="TESTS PASSED"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,-12,0,0" />
                        </StackPanel>
                    </Grid>
                </TabItem>
                <TabItem Header="{Binding Path=CantFailed}" Foreground="{StaticResource RedBrush}">
                    <ListBox Name="ListFailed"
                             ItemsSource="{Binding Path=FailedTestsCollection, Mode=OneWay}"
                             MouseDoubleClick="List_MouseDoubleClick"
                             KeyDown="List_KeyDown" />
                </TabItem>
                <TabItem Header="{Binding Path=CantIntegration}" Foreground="{StaticResource TealBrush}">
                    <ListBox Name="ListIntegration"
                             ItemsSource="{Binding Path=IntegrationTestsCollection, Mode=OneWay}"
                             MouseDoubleClick="List_MouseDoubleClick"
                             KeyDown="List_KeyDown" />
                </TabItem>
                <TabItem Header="{Binding Path=CantFwk}" Foreground="{StaticResource PurpleBrush}">
                    <ListBox Name="ListFwk"
                             ItemsSource="{Binding Path=FwkTestsCollection, Mode=OneWay}"
                             MouseDoubleClick="List_MouseDoubleClick"
                             KeyDown="List_KeyDown" />
                </TabItem>
            </TabControl>
        </DockPanel>
    </Grid>
</Window>
